<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Smart Maps OS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- Custom URL scheme for OAuth deep-link callbacks (Spotify, etc.) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.smartmaps.os</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.smartmaps.os</string>
			</array>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Location & motion permissions for Immersive Navigation -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Smart Maps OS needs your location to show your position and provide turn-by-turn navigation.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Smart Maps OS needs your location to keep navigation accurate even when the app is in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Smart Maps OS needs your location to keep navigation accurate even when the app is in the background.</string>
	<key>NSMotionUsageDescription</key>
	<string>Smart Maps OS uses motion sensors for dead-reckoning when GPS or Wi-Fi positioning is unavailable.</string>

	<!-- AutoEx external bridge permissions -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Smart Maps OS uses Bluetooth to connect to AutoEx companion devices for offline positioning.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Smart Maps OS uses Bluetooth to connect to AutoEx companion devices for offline positioning.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Smart Maps OS uses the local network for AutoEx Wi-Fi Direct or WebSocket transports during development.</string>

	<!--
	  Background modes — declared but disabled for the proto. Uncomment the
	  UIBackgroundModes array below to enable continued location updates or
	  Bluetooth Central operation while the app is in the background.

	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
	</array>
	-->

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>

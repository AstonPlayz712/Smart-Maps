<?xml version="1.0" encoding="utf-8"?>
<!-- Smart Maps adaptive grid — PHONE bucket (default).
     8dp micro grid everywhere; 16dp macro grid on phones.
     sw600dp / sw720dp buckets override these for tablets. -->
<resources>
    <!-- grid -->
    <dimen name="sm_grid_micro">8dp</dimen>
    <dimen name="sm_grid_macro">16dp</dimen>
    <dimen name="sm_edge_margin">16dp</dimen>

    <!-- floating search -->
    <dimen name="sm_search_height">52dp</dimen>
    <dimen name="sm_search_max_width">480dp</dimen>

    <!-- mode cluster -->
    <dimen name="sm_cluster_chip">56dp</dimen>
    <dimen name="sm_cluster_gap">8dp</dimen>

    <!-- cards -->
    <dimen name="sm_card_corner">16dp</dimen>
    <dimen name="sm_card_pane_width">360dp</dimen>
    <dimen name="sm_card_inner_padding">16dp</dimen>

    <!-- live state -->
    <integer name="sm_live_state_columns">1</integer>

    <!-- navigation layer -->
    <dimen name="sm_nav_icon">24dp</dimen>
    <bool name="sm_side_navigation">false</bool>

    <!-- map -->
    <integer name="sm_map_meters_per_screen">900</integer>

    <bool name="sm_is_tablet">false</bool>
</resources>

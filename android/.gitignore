# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml

# Keystore files
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Android Profiling
*.hprof

# NOTE: The following entries were previously gitignored but are now committed
# so the Gradle build works even when Appflow's pipeline skips
# `npx cap sync android` (it sometimes misclassifies us as Cordova). Without
# committing them you get a black screen on launch — the WebView has no
# assets to load.
#
# capacitor-cordova-android-plugins        ← committed (cordova plugin shim project)
# app/src/main/assets/public               ← committed (Vite dist bundle)
# app/src/main/assets/capacitor.config.json ← committed (synced runtime config)
# app/src/main/assets/capacitor.plugins.json ← committed (synced plugin manifest)
# app/src/main/res/xml/config.xml          ← committed (legacy cordova config)

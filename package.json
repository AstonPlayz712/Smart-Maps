{
  "name": "smart-maps-dse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Smart Maps Dynamic Spatial Engine — sm-core plus the web and mobile shells that drive it. Not an operating system.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "native:android": "echo 'cd native/android && ./gradlew assembleDebug'",
    "native:ios": "echo 'cd native/ios && xcodegen generate (see native/MIGRATION.md)'"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
